{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:peaches:schema:floor-v1",
  "title": "PEACHES Floor v1 objects",
  "description": "Structural schema only. FLOOR.md defines strict parsing, canonicalization, decoded lengths, calendar validity, derived identifiers, digests, and signatures.",
  "oneOf": [
    {
      "$ref": "#/$defs/stamp"
    },
    {
      "$ref": "#/$defs/observation"
    }
  ],
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuerId": {
      "type": "string",
      "pattern": "^peaches:issuer:v1:[0-9a-f]{64}$"
    },
    "stampId": {
      "type": "string",
      "pattern": "^peaches:stamp:v1:[0-9a-f]{64}$"
    },
    "rubricId": {
      "type": "string",
      "pattern": "^peaches:rubric:v1:[0-9a-f]{64}$"
    },
    "observationId": {
      "type": "string",
      "pattern": "^peaches:observation:v1:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "bytes",
        "sha256"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[\\u0020-\\u007e]+$"
        },
        "bytes": {
          "$ref": "#/$defs/base64url"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_type",
        "public_key",
        "issuer_id"
      ],
      "properties": {
        "key_type": {
          "const": "Ed25519"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "issuer_id": {
          "$ref": "#/$defs/issuerId"
        }
      }
    },
    "unsignedStamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "floor",
        "issuer",
        "declaration",
        "claimed_at",
        "nonce",
        "rubric_id"
      ],
      "properties": {
        "schema": {
          "const": "peaches.floor.stamp/1"
        },
        "floor": {
          "const": "peaches.floor/1"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "declaration": {
          "$ref": "#/$defs/content"
        },
        "claimed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "rubric_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rubricId"
            }
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "value"
      ],
      "properties": {
        "suite": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "floor",
        "issuer",
        "declaration",
        "claimed_at",
        "nonce",
        "rubric_id",
        "stamp_id",
        "signature"
      ],
      "properties": {
        "schema": {
          "const": "peaches.floor.stamp/1"
        },
        "floor": {
          "const": "peaches.floor/1"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "declaration": {
          "$ref": "#/$defs/content"
        },
        "claimed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "rubric_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rubricId"
            }
          ]
        },
        "stamp_id": {
          "$ref": "#/$defs/stampId"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "observationCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "floor",
        "stamp_id",
        "observed_no_later_than",
        "method_id",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "peaches.floor.observation/1"
        },
        "floor": {
          "const": "peaches.floor/1"
        },
        "stamp_id": {
          "$ref": "#/$defs/stampId"
        },
        "observed_no_later_than": {
          "$ref": "#/$defs/timestamp"
        },
        "method_id": {
          "$ref": "#/$defs/rubricId"
        },
        "evidence": {
          "$ref": "#/$defs/content"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "floor",
        "stamp_id",
        "observed_no_later_than",
        "method_id",
        "evidence",
        "observation_id"
      ],
      "properties": {
        "schema": {
          "const": "peaches.floor.observation/1"
        },
        "floor": {
          "const": "peaches.floor/1"
        },
        "stamp_id": {
          "$ref": "#/$defs/stampId"
        },
        "observed_no_later_than": {
          "$ref": "#/$defs/timestamp"
        },
        "method_id": {
          "$ref": "#/$defs/rubricId"
        },
        "evidence": {
          "$ref": "#/$defs/content"
        },
        "observation_id": {
          "$ref": "#/$defs/observationId"
        }
      }
    }
  }
}
